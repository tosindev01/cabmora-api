APP_NAME=Cabmora API
ENVIRONMENT=local
DATABASE_URL=sqlite+aiosqlite:///./cabmora.db
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:5173"]

# Browser session cookie. Set COOKIE_SECURE=false only where there is no TLS.
SESSION_COOKIE_NAME=cabmora_session
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# --- Outbound email -------------------------------------------------------
# "logging" prints invite links instead of sending them. That is correct
# locally and a silent failure in production: the account exists, the token
# exists, and the customer never hears about it.
#
# Set to "mailtrap" only with a token — the app refuses to start otherwise,
# rather than pretending to send.
#
# Mailtrap sells "Email Testing" and "Email Sending" at almost the same price.
# Testing delivers to a fake inbox. You want SENDING.
EMAIL_BACKEND=logging
MAILTRAP_API_TOKEN=
# The From address. Must be on a domain Mailtrap has verified.
# Until cabmoramedia.com verifies, hello@demomailtrap.co is the only working
# sender — and it delivers ONLY to the Mailtrap account owner's address, so
# client-facing mail silently 403s. Switch to hello@cabmoramedia.com the moment
# the DNS records are in.
MAILTRAP_SENDER=hello@cabmoramedia.com
MAILTRAP_SENDER_NAME=Cabmora
# Reply-To, and the address printed in every footer. Separate from the sender
# on purpose: while MAILTRAP_SENDER is a demo/stand-in domain, a reply that
# followed the From address would go nowhere. Must be a mailbox someone reads.
SUPPORT_EMAIL=hello@cabmoramedia.com

# Where "new enquiry" notifications go. Unset means nobody is told.
ENQUIRY_NOTIFICATION_EMAIL=

# The admin console's origin. Two uses: a "new enquiry" notification can link
# straight to the lead, and a coordinator or administrator invited by an admin
# is sent here to choose their password rather than to the public site — the
# session cookie is scoped to the host that sets it. Inviting staff is refused
# while this is unset, rather than sending them somewhere they cannot work.
#
# `admin.localhost` and not `localhost` in development: cookies ignore ports,
# so both consoles on plain localhost would share one session and signing into
# either would sign you out of the other.
ADMIN_BASE_URL=http://admin.localhost:5174

# Where invite links point — the public site, not the API.
PUBLIC_BASE_URL=http://localhost:5173

# Consultations. "manual" records a link the admin pasted; "google" creates the
# call in Cabmora's own calendar so picking a date is the whole interaction.
# Obtain the refresh token once with: python -m scripts.google_authorize
MEETING_BACKEND=manual
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Media. "local" writes to ./var/media and serves through this API — development
# only; the config guard refuses it outside local. "r2" presigns so bytes never
# touch the container.
MEDIA_BACKEND=local
MEDIA_ROOT=./var/media
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 'eu' for an EU-jurisdiction bucket — changes the endpoint host.
R2_JURISDICTION=

# --- Crash reporting (optional) ---------------------------------------
# Empty means crashes go to the log only, which is the default and is fine
# locally. Any Sentry-protocol endpoint works — sentry.io or a self-hosted
# GlitchTip — so this is not a commitment to one vendor's pricing.
SENTRY_DSN=
# Performance tracing is a separate product from crash reporting and is
# where the cost is. Leave at 0 unless you mean it.
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Stripe (card payments) -------------------------------------------
# Both or neither. The API refuses to start with a secret key and no
# webhook secret: that is the state where checkout works and the callback
# confirming payment cannot be verified, so customers pay and invoices
# never settle.
#
# Leave both empty locally. The gateway is chosen by whether keys are
# present, so empty means the fake gateway — which takes no money and is
# what you want while building.
#
# A restricted key (rk_...) with write access to Checkout Sessions is
# enough and is preferred: a leaked one can create a payment link, not
# read your customers or refund your takings.
#
# Test keys and live keys have separate webhook endpoints with separate
# signing secrets. Never mix a key from one mode with a secret from the
# other — checkout succeeds and every confirmation fails to verify.
STRIPE_SECRET_KEY=
# From the webhook endpoint you create, not from the API keys page.
STRIPE_WEBHOOK_SECRET=

# --- Bank transfer, to Cabmora's own account -------------------------------
#
# Printed on every invoice and shown in the client portal, for a client who
# pays by transfer rather than by card. A transfer here is reconciled by hand:
# an administrator sees it land and confirms the payment, which is what makes
# the invoice settle. (Stripe-issued account numbers are a different thing
# entirely — those settle themselves; see `gb_bank_transfer_payments`.)
#
# All four or none. `BankTransferDetails.configured` treats a partial set as
# none at all, so three of the four looks identical to zero of them — which is
# the first thing to check when the details do not appear. Never a placeholder:
# somebody will pay whatever is printed.
BANK_ACCOUNT_NAME=
BANK_NAME=
BANK_SORT_CODE=
BANK_ACCOUNT_NUMBER=
# Optional. Shown when set, omitted when not.
BANK_IBAN=
